SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_ADMIN_EMAIL=admin@aure.demo
DEMO_ADMIN_PASSWORD=replace-with-a-strong-local-password
# local uses data/store.json; supabase uses the private live-store migration.
DATA_BACKEND=local
# Optional canonical public origin for an HTTPS reverse proxy, e.g. https://shop.example
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional direct connection for applying migrations from your machine. Server-only.
DATABASE_URL=
# Legacy keys are also accepted:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
